# App mode is explicit. Live configuration errors NEVER select demo fixtures.
NEXT_PUBLIC_APP_MODE=live
# Set demo explicitly only for local design/fixture work (restart Next.js).
# NEXT_PUBLIC_APP_MODE=demo

# Public browser configuration; either key spelling is supported.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key-here

# Configure these as SUPABASE EDGE FUNCTION SECRETS, never NEXT_PUBLIC vars:
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_AUDIO_MODEL=an-enabled-audio-capable-model-in-your-account
# Supabase injects SUPABASE_URL and SUPABASE_ANON_KEY into the Edge runtime.
